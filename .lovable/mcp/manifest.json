{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ypcoludurdfinazcxylj.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "nextgen-summit-mcp",
      "version": "0.1.0",
      "title": "NextGen Summit MCP"
    },
    "tools": [
      {
        "name": "whoami",
        "title": "Who am I",
        "description": "Return the signed-in user's id, email, and app roles.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_my_registrations",
        "title": "List my registrations",
        "description": "List NextGen Summit registrations belonging to the signed-in user.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_scholarship_applicants",
        "title": "List scholarship applicants",
        "description": "List scholarship applicants (admin or selection_team only, enforced by RLS). Optional status filter.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "shortlisted",
                "accepted",
                "rejected",
                "waitlist"
              ],
              "description": "Filter by review status."
            },
            "limit": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 500,
              "description": "Max rows (default 100)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_applicant_status",
        "title": "Update applicant status",
        "description": "Update a scholarship applicant's review status and optional notes. Requires admin or selection_team role (enforced by RLS).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "applicant_id": {
              "type": "string",
              "format": "uuid",
              "description": "Applicant row id."
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "shortlisted",
                "accepted",
                "rejected",
                "waitlist"
              ]
            },
            "notes": {
              "type": "string",
              "description": "Reviewer notes (max 1000 chars)."
            }
          },
          "required": [
            "applicant_id",
            "status"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
